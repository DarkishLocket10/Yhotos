{
  "db_name": "PostgreSQL",
  "query": "WITH RECURSIVE chain AS (\n      SELECT a.*, 1 AS depth FROM albums a WHERE parent_id IS NULL AND slug=($1::text[])[1]::citext\n      UNION ALL SELECT a.*, c.depth+1 FROM albums a JOIN chain c ON a.parent_id=c.id\n      WHERE a.slug=($1::text[])[c.depth+1]::citext AND c.depth < cardinality($1)\n    ) SELECT id as \"id!: _\", created_at AS \"created_at!\", updated_at AS \"updated_at!\", parent_id as \"parent_id: _\", slug as \"slug!: _\", title AS \"title!\", description AS \"description!\", sort_order AS \"sort_order!\", cover_photo_id as \"cover_photo_id: _\", visibility as \"visibility!: _\", manual_order AS \"manual_order!\", deleted_at FROM chain WHERE depth=cardinality($1)",

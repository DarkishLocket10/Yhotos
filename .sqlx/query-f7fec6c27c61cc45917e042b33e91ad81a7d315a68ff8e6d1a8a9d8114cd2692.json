  "query": "SELECT p.id,p.name,count(f.id) AS \"count!\" FROM persons p\n        JOIN faces f ON f.person_id=p.id JOIN photos photo ON photo.id=f.photo_id\n        WHERE NOT p.hidden AND photo.deleted_at IS NULL GROUP BY p.id ORDER BY p.name NULLS LAST,p.id LIMIT 200",

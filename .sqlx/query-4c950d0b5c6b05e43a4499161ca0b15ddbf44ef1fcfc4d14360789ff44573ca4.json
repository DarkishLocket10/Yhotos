  "query": "SELECT m.image_id,p.id,p.short_id,p.original_hash,p.original_name,a.id AS album_id,a.visibility::text AS \"visibility!\" FROM migration_sources m JOIN photos p ON p.id=m.photo_id JOIN albums a ON a.id=p.album_id WHERE m.image_id>=10 ORDER BY m.image_id"

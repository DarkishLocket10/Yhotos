{
  "db_name": "PostgreSQL",
  "query": "WITH RECURSIVE chain AS (SELECT a.*, 0 AS depth, ARRAY[a.id] AS visited FROM albums a WHERE id=$1 UNION ALL SELECT a.*, c.depth+1, c.visited || a.id FROM albums a JOIN chain c ON c.parent_id=a.id WHERE NOT a.id=ANY(c.visited)) SELECT id as \"id!: _\", created_at AS \"created_at!\", updated_at AS \"updated_at!\", parent_id as \"parent_id: _\", slug as \"slug!: _\", title AS \"title!\", description AS \"description!\", sort_order AS \"sort_order!\", cover_photo_id as \"cover_photo_id: _\", visibility as \"visibility!: _\", manual_order AS \"manual_order!\", deleted_at FROM chain WHERE depth>0 ORDER BY depth",

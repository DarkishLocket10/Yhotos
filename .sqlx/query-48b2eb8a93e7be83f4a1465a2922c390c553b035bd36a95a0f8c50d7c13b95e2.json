  "query": "SELECT m.photo_id,m.original_hash,m.taken_at AS source_taken,m.taken_at_local AS source_local,m.gps_lat AS source_lat,m.gps_lon AS source_lon,p.gps_lat,p.gps_lon,p.deleted_at,p.status::text AS \"status!\",p.derivative_plan,EXISTS(SELECT 1 FROM derivatives d WHERE d.photo_id=p.id) AS \"has_derivatives!\" FROM migration_sources m JOIN photos p ON p.id=m.photo_id WHERE m.image_id=$1 AND m.category_id=$2 FOR UPDATE OF p",

  "query": "SELECT p.id as \"id: _\", p.created_at, p.updated_at, p.short_id as \"short_id: _\", p.album_id as \"album_id: _\", p.title, p.description, p.taken_at, p.posted_at, p.sort_order, p.visibility as \"visibility: _\", p.original_hash, p.original_name, p.original_bytes, p.mime, p.kind as \"kind: _\", p.width, p.height, p.orientation, p.is_hdr, p.has_gain_map, p.icc_name, p.camera_make, p.camera_model, p.lens, p.focal_mm, p.aperture, p.shutter, p.iso, p.gps_lat, p.gps_lon, p.place_id, p.dominant_colors, p.placeholder, p.deleted_at FROM photos p JOIN likes l ON l.photo_id=p.id WHERE l.user_id=$1 AND p.deleted_at IS NULL ORDER BY l.created_at DESC,l.id LIMIT 50 OFFSET $2",
